{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=his.db"
  },
  "Jwt": {
    "Issuer": "HIS.Api",
    "Audience": "HIS.Client",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "PrivateKeyPath": "Keys/jwt-private.pem",
    "PublicKeyPath": "Keys/jwt-public.pem"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
